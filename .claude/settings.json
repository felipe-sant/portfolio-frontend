{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsx --tsconfig tsconfig.node.json .claude/hooks/guardBash.ts"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsx --tsconfig tsconfig.node.json .claude/hooks/formatFile.ts"
                    }
                ]
            }
        ]
    }
}
