{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["esnext"],
        "types": ["node", "vite/client"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "paths": {
            "@/*": ["./src/*"],
            "@scripts/*": ["./scripts/*"]
        },
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
    },
    "include": ["vite.config.ts", "scripts", ".claude/hooks"],
    "exclude": [
        "scripts/test/listTargets.test.ts",
        "scripts/test/listSitemapEntries.test.ts",
        "scripts/test/writeSeoFiles.test.ts"
    ]
}
