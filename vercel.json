{
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/cv/(.*)\\.md",
            "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
        },
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/fonts/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/images/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
        }
    ]
}
