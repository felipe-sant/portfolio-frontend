{
  "name": "portfolio-frontend",
  "description": "Portfólio pessoal de Luiz Felipe dos Santos, desenvolvedor full stack.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.11",
    "lowlight": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && npm run build:server && npm run prerender",
    "build:server": "vite build --ssr --outDir dist-server",
    "prerender": "tsx --tsconfig tsconfig.node.json scripts/prerender.ts",
    "preview": "vite preview",
    "build:fatec": "tsx --tsconfig tsconfig.node.json scripts/buildFatec.ts",
    "publish:fatec:docs": "tsx --tsconfig tsconfig.node.json scripts/publishFatecDocs.ts",
    "build:fatec:form": "tsx --tsconfig tsconfig.node.json scripts/buildFatecForm.ts",
    "preview:fatec": "tsx --tsconfig tsconfig.node.json scripts/previewFatec.ts",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,yml,html}\"",
    "og:image": "tsx --tsconfig tsconfig.node.json scripts/generateOgImage.ts",
    "check:chunk": "tsx --tsconfig tsconfig.node.json scripts/checkMarkdownChunk.ts",
    "content:id": "tsx --tsconfig tsconfig.node.json scripts/newId.ts",
    "content:template": "tsx --tsconfig tsconfig.node.json scripts/generateContentTemplate.ts",
    "content:placeholders": "tsx --tsconfig tsconfig.node.json scripts/generatePlaceholderImages.ts",
    "content:check": "vitest run src/services/content/test/content.test.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
