{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["esnext", "dom"],
        "types": ["node"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "paths": {
            "@scripts/*": ["./scripts/*"]
        },
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
    },
    "include": ["e2e", "playwright.config.ts"]
}
